# 配布通知は実際の依存物の原文からコピーし、元ファイルとの対応を残す。
set(mcwiiu_license_entries "")
get_filename_component(mcwiiu_workspace "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
function(mcwiiu_license component source destination)
    if(NOT EXISTS "${source}" OR IS_DIRECTORY "${source}")
        message(FATAL_ERROR "Required distribution notice is missing: ${component}: ${source}")
    endif()
    file(SIZE "${source}" notice_size)
    if(notice_size EQUAL 0)
        message(FATAL_ERROR "Required distribution notice is empty: ${component}")
    endif()
    file(SHA256 "${source}" source_hash)
    if(ARGC EQUAL 4 AND ARGV3 STREQUAL "LEADING_COMMENTS")
        file(READ "${source}" original)
        string(FIND "${original}" "\n#" header_end)
        if(header_end LESS 1 OR header_end GREATER 16384)
            message(FATAL_ERROR "Cannot locate original license preamble: ${source}")
        endif()
        string(SUBSTRING "${original}" 0 ${header_end} notice)
        if(NOT notice MATCHES "Copyright" OR NOT notice MATCHES "Redistribution" OR NOT notice MATCHES "SOFTWARE")
            message(FATAL_ERROR "Incomplete original license preamble: ${source}")
        endif()
        file(WRITE "${CMAKE_BINARY_DIR}/bin/licenses/${destination}" "${notice}")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source}")
    else()
        configure_file("${source}" "${CMAKE_BINARY_DIR}/bin/licenses/${destination}" COPYONLY)
    endif()
    file(SHA256 "${CMAKE_BINARY_DIR}/bin/licenses/${destination}" notice_hash)
    file(RELATIVE_PATH source_relative "${mcwiiu_workspace}" "${source}")
    set(entry "{\"component\":\"${component}\",\"source\":\"${source_relative}\",\"source_sha256\":\"${source_hash}\",\"path\":\"licenses/${destination}\",\"sha256\":\"${notice_hash}\"}")
    list(APPEND mcwiiu_license_entries "${entry}")
    set(mcwiiu_license_entries "${mcwiiu_license_entries}" PARENT_SCOPE)
endfunction()

mcwiiu_license(Cemu "${mcwiiu_workspace}/LICENSE.txt" Cemu-LICENSE.txt)
mcwiiu_license(saucer "${saucer_SOURCE_DIR}/LICENSE" saucer-LICENSE)
mcwiiu_license(Discord-Social-SDK "${MCWIIU_DISCORD_SDK_NOTICES}" Discord-Social-SDK-NOTICES.txt)
foreach(component IN ITEMS coco rebind ereignis flagpp polo lockpp glaze saucer-fill)
    if(component STREQUAL "coco")
        set(notice LICENSE.md)
    else()
        set(notice LICENSE)
    endif()
    mcwiiu_license("${component}" "${${component}_SOURCE_DIR}/${notice}" "${component}-LICENSE.txt")
endforeach()
mcwiiu_license(WebView2 "${saucer_BINARY_DIR}/nuget/packages/Microsoft.Web.WebView2.${saucer_webview2_version}/LICENSE.txt" WebView2-LICENSE.txt)

foreach(component IN ITEMS cubeb ZArchive)
    mcwiiu_license("${component}" "${mcwiiu_workspace}/dependencies/${component}/LICENSE" "${component}-LICENSE.txt")
endforeach()
mcwiiu_license(imgui "${mcwiiu_workspace}/dependencies/imgui/LICENSE.txt" imgui-LICENSE.txt)
foreach(source IN ITEMS resample.c resample_sse.h arch.h fixed_generic.h speex_resampler.h stack_alloc.h)
    mcwiiu_license(speex-resampler "${mcwiiu_workspace}/dependencies/cubeb/subprojects/speex/${source}" "speex-${source}.txt" LEADING_COMMENTS)
endforeach()
mcwiiu_license(ih264d "${mcwiiu_workspace}/dependencies/ih264d/NOTICE" ih264d-NOTICE.txt)
mcwiiu_license(ih264d "${CMAKE_CURRENT_LIST_DIR}/installer/licenses/Apache-2.0.txt" ih264d-Apache-2.0.txt)
mcwiiu_license(Vulkan-Headers "${mcwiiu_workspace}/dependencies/Vulkan-Headers/LICENSE.md" Vulkan-Headers-LICENSE.md)
foreach(license IN ITEMS Apache-2.0 MIT)
    mcwiiu_license(Vulkan-Headers "${mcwiiu_workspace}/dependencies/Vulkan-Headers/LICENSES/${license}.txt" "${license}.txt")
endforeach()
foreach(license IN ITEMS FontAwesome-OFL-1.1 FontAwesome-COPYRIGHT)
    mcwiiu_license(FontAwesome "${CMAKE_CURRENT_LIST_DIR}/installer/licenses/${license}.txt" "${license}.txt")
endforeach()

# Windows Nativeのリンク依存集合。ホスト専用vcpkg helperは配布されない。
set(mcwiiu_vcpkg_share "${mcwiiu_workspace}/out/build/Release/vcpkg_installed/x64-windows-static/share")
foreach(component IN ITEMS openssl curl libpng expat wxwidgets zlib libzip)
    if(NOT EXISTS "${mcwiiu_vcpkg_share}/${component}/copyright")
        message(FATAL_ERROR "Required vcpkg notice is missing: ${component}")
    endif()
endforeach()
file(GLOB vcpkg_notices CONFIGURE_DEPENDS "${mcwiiu_vcpkg_share}/*/copyright")
foreach(notice IN LISTS vcpkg_notices)
    get_filename_component(parent "${notice}" DIRECTORY)
    get_filename_component(component "${parent}" NAME)
    if(NOT component MATCHES "^(vcpkg-|boost-cmake$|boost-uninstall$)")
        mcwiiu_license("${component}" "${notice}" "${component}-copyright.txt")
    endif()
endforeach()
list(JOIN mcwiiu_license_entries "," mcwiiu_license_json)
file(WRITE "${CMAKE_BINARY_DIR}/bin/license-inventory.json" "{\"schema_version\":1,\"notices\":[${mcwiiu_license_json}]}")
