#include <windows.h>
1 VERSIONINFO
 FILEVERSION @MCWIIU_FOUNDATION_VERSION_TUPLE@,0
 PRODUCTVERSION @MCWIIU_FOUNDATION_VERSION_TUPLE@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "IGNSeed"
   VALUE "FileDescription", "MCWiiU Launcher Foundation"
   VALUE "FileVersion", "@MCWIIU_FOUNDATION_VERSION@"
   VALUE "ProductName", "MCWiiU Launcher"
   VALUE "ProductVersion", "@MCWIIU_FOUNDATION_VERSION@"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
